# Database (PostgreSQL via Supabase, Railway, Neon, or PlanetScale)
DATABASE_URL="postgresql://user:password@host:5432/trustvoice"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Resend (magic link email) — resend.com
AUTH_RESEND_KEY=""
EMAIL_FROM="noreply@trustvoice.app"

# Stripe — dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_CLIENT_ID="ca_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# LiveKit — livekit.io/cloud
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://your-project.livekit.cloud"

# Cron (daily revenue re-verification)
CRON_SECRET="optional-cron-secret-token"
